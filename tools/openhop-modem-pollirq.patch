+// ─── DIO1-less completion detection (PYMC_POLL_IRQ) ─────────
+// For boards whose DIO1 net is physically broken. setDio1Action() is the
+// only thing that ever sets dio1Flag, so a dead line means RX_DONE/TX_DONE
+// never reach the MCU: handleLoRaRx() is never called (radio looks deaf at
+// full signal) and every TX ends in the "hard timeout" reset path while the
+// frames actually radiate.
+//
+// The SX1262 latches those events in its IRQ status register whether or not
+// they are routed out to a DIO pin, so reading it over SPI bypasses the net
+// entirely — and therefore works regardless of WHICH end died (nRF52 input
+// pad, SX1262 output, or a cut trace). Rewiring DIO1 to a spare GPIO only
+// helps in the first of those three cases.
+//
+// Cost: one SPI read per loop() pass plus one per wait-loop iteration, and
+// completion is noticed on the next pass instead of instantly.
+#ifdef PYMC_POLL_IRQ
+static const uint16_t POLL_IRQ_MASK =
+    RADIOLIB_SX126X_IRQ_RX_DONE  | RADIOLIB_SX126X_IRQ_TX_DONE |
+    RADIOLIB_SX126X_IRQ_CAD_DONE | RADIOLIB_SX126X_IRQ_TIMEOUT;
+
+static inline void pollDio1() {
+    if (!radioReady || dio1Flag) return;
+    if (radio.getIrqFlags() & POLL_IRQ_MASK) {
+        dio1Flag = true;
+        dio1IrqCount = dio1IrqCount + 1;
+    }
+}
+#else
+static inline void pollDio1() {}
+#endif
+
