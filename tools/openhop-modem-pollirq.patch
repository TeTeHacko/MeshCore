+[env:xiao_nrf52_wio_pollirq]
+; Same board as above, for tth-x0 (sn 30911219DA28411D) whose DIO1 net was
+; killed by a breadboard short (GND on D1) on 29. 7. 2026. `dio1` on the
+; MeshCore firmware reports irq=0x0001 (TX_DONE latched) while the pin reads
+; 0, so the stock interrupt-driven modem firmware is deaf and mute on this
+; board. PYMC_POLL_IRQ reads the SX1262 IRQ register over SPI instead.
+extends = env:xiao_nrf52_wio
+build_flags =
+    ${env:xiao_nrf52_wio.build_flags}
+    -DPYMC_POLL_IRQ=1
+
